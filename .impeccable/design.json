      "html": "<button class=\"ds-quiet\">Simular entrega inválida</button> <button class=\"ds-quiet ds-danger\">Vaciar</button>",
      "css": ".ds-quiet{height:36px;padding:0 12px;border-radius:8px;border:1px solid var(--line,#d2dbe7);background:transparent;color:var(--ink,#14213d);font:600 13px system-ui,sans-serif;cursor:pointer;transition:background-color .15s,border-color .15s,color .15s}.ds-quiet:hover{background:var(--sheet-2,#f4f7fb);border-color:var(--ink-2,#4b5b78)}.ds-danger:hover{color:var(--err,#b81d2f);border-color:var(--err,#b81d2f)}.ds-quiet:focus-visible{outline:2px solid var(--focus,#1f6fe0);outline-offset:2px}"
