      "refersTo": "button-primary",
      "description": "The single filled action (Copiar URL).",
      "html": "<button class=\"ds-btn\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\"><rect x=\"9\" y=\"9\" width=\"12\" height=\"12\" rx=\"2\"/><path d=\"M5 15V5a2 2 0 0 1 2-2h10\"/></svg>Copiar URL</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 16px;border-radius:8px;border:1px solid transparent;font:600 14px system-ui,sans-serif;background:var(--action,#15254a);color:var(--action-ink,#fff);cursor:pointer;transition:background-color .15s}.ds-btn:hover{background:var(--action-hover,#22386a)}.ds-btn:focus-visible{outline:2px solid var(--focus,#1f6fe0);outline-offset:2px}.ds-icon{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}"
    },
